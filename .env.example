DORTGOZ_MOCK=1
# development: yeni klon, her OpenAI-uyumlu uç (yerel dahil), eksik bileşende düşer.
# competition-real: yalnız EVREN; dev.sh real / preflight --mode real bunu zorlar.
DORTGOZ_DEPLOYMENT_PROFILE=development
DORTGOZ_EVENT_STORE_PATH=runs/event_memory.sqlite3
DORTGOZ_LLAMA_BASE_URL=https://<yarisma-cikarim-ucu>/v1
# Gerçek modda boş bırakılamaz; anahtar istemeyen yerel uç için herhangi bir değer yazın.
DORTGOZ_API_KEY=
DORTGOZ_MAIN_MODEL=llm-fast
DORTGOZ_VIDEO_MODEL=vlm
DORTGOZ_SECOND_OPINION_MODEL=llm-large
DORTGOZ_AGENT_MODEL=llm-fast
DORTGOZ_ROUTER_MODEL=router
DORTGOZ_GUARD_MODEL=guard
DORTGOZ_EMBEDDING_MODEL=bge-m3-embed
DORTGOZ_CANDIDATE_START_THRESHOLD=0.80
DORTGOZ_CANDIDATE_CONTINUE_THRESHOLD=0.48
DORTGOZ_CATEGORY_RULES_ENABLED=0
DORTGOZ_LOCAL_INFERENCE_LIMIT=2

# --- Yerel algı (SigLIP + D-FINE) donanımı -----------------------------------
# Varsayılan CPU'dur ve her makinede çalışır. GPU'nuz varsa birini seçin.
# Ayrıntı ve kurulum: docs/SETUP.md §3.4
#
# NVIDIA (CUDA) — onnxruntime-gpu kurulu olmalı:
#   auto = varsa GPU kullan, yoksa sessizce CPU'ya dön
#   gpu  = GPU iste; yoksa uyarı basar ve CPU'ya döner
DORTGOZ_ONNX_DEVICE=cpu
# Sağlayıcı listesini elle vermek isterseniz (DORTGOZ_ONNX_DEVICE'i ezer):
# DORTGOZ_ONNX_PROVIDERS=CUDAExecutionProvider
#
# AMD (ROCm / MIGraphX) — önce ./scripts/build_migraphx.sh çalıştırın.
# Boş bırakılırsa GPU yolu kapalıdır.
# DORTGOZ_MIGRAPHX_DIR=~/.cache/dortgoz/migraphx
#
# CPU'da kalan iş için iş parçacığı sayısı:
# DORTGOZ_ONNX_INTRA_THREADS=4
# --- D-FINE geri besleme eğitimi (Öğrenme çalışma alanı) ---------------------
# Bu üç yol dolu değilse Öğrenme sekmesi paket ve eğitim düğmelerini kapalı
# tutar ve eksik olanı ekranda yazar. Eğitim yalnız insan başlatır.
# DORTGOZ_DFINE_TRAINING_REPOSITORY=~/src/D-FINE
# DORTGOZ_DFINE_BASE_CHECKPOINT=models/dfine/dfine_n_coco.pth
# DORTGOZ_DFINE_DATASET_MANIFEST=runs/datasets/egitim_manifest.json
# Eğitimi başka bir python ile çalıştırmak isterseniz:
# DORTGOZ_DFINE_PYTHON=~/src/D-FINE/.venv/bin/python
# --- EVREN Qdrant (prosedür RAG) ---------------------------------------------
# Yalnız competition-real profilinde zorunludur (dev.sh real / preflight --mode real).
# development profilinde boş kalabilir; prosedür getirme yerel dizinle çalışır.
DORTGOZ_QDRANT_URL=
DORTGOZ_QDRANT_PREFIX=
DORTGOZ_QDRANT_API_KEY=

# --- UCF-Crime veri kümesi (kaynak listesi) ---------------------------------
# Dolu ise Analiz sekmesindeki kaynak listesi bu kökteki bütün videoları da
# gösterir. Küme salt okunur; depoya hiçbir klip girmez. Yol makineye göre
# değişir; kümenin indirildiği diskteki Videos klasörünü verin.
# DORTGOZ_UCF_DIR=
