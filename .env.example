# Dörtgöz ortam şablonu — bu dosya commit edilir, doldurulmuş .env edilmez.
# Kopyalayın: cp .env.example .env  (PowerShell: Copy-Item .env.example .env)
# Backend, repo kökündeki .env dosyasını otomatik okur.

# GitHub'dan yeni klonda güvenli varsayılan: model/GPU gerektirmeyen arayüz test akışı.
# Bu kip video analizi yapmaz. Gerçek yerel analiz için değeri 0 yapın.
DORTGOZ_MOCK=1
DORTGOZ_DEPLOYMENT_PROFILE=development

# Bulut izleme kesin olarak kapalıdır. Sistem yalnız yerel/özel ağda çalışır.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# ── Gerçek yerel model sunucusu (OpenAI-uyumlu, bulut değil) ───────────────────
# Aynı bilgisayarda llama.cpp kullanılıyorsa bu varsayılan uygundur.
# Başka bir izinli özel ağ makinesi kullanılacaksa adresi yalnız kendi .env'inizde değiştirin.
# Gerçek endpoint, model ağırlığı ve erişim bilgisi Git'e eklenmez.
DORTGOZ_LLAMA_BASE_URL=http://127.0.0.1:8080/v1
DORTGOZ_API_KEY=local
DORTGOZ_MAIN_MODEL=qwen3.6-35b-a3b-vision

# ── Yerel ONNX çıkarımı ──────────────────────────────────────────────────────
# Varsayılan CPU yolu masaüstü AMD ve dizüstü için güvenli ortak ayardır.
# Ölçülen en hızlı kararlı CPU ayarı 4 iç ipliktir. 0, ONNX Runtime kararına bırakır.
DORTGOZ_ONNX_DEVICE=cpu
DORTGOZ_ONNX_INTRA_THREADS=4

# ── Kapanmış olay sınıf hakemi ───────────────────────────────────────────────
# Hakem yalnız listedeki kapanmış olayların sınıfını yeniden seçer.
# Yeni olay açmaz. Boş değer hakemi kapatır.
DORTGOZ_ADJUDICATE_CONFUSABLE=hirsizlik,kavga,saldiri,bilinmeyen,arac_kazasi
DORTGOZ_ADJUDICATE_MIN_CONF=0.0
DORTGOZ_ADJUDICATE_FRAME_WIDTH=512

# Gerçek candidate-only VLM profili için local manifest zorunludur. Şablonu kopyalayın:
#   Copy-Item models/vlm/manifest.template.json models/vlm/manifest.local.json
# ardından artifact_path, SHA-256, lisans, sürüm ve model kimliğini doldurun.
# models/vlm/manifest.local.json Git tarafından yok sayılır.
# DORTGOZ_VLM_MANIFEST_PATH=models/vlm/manifest.local.json

# ── Anlamsal screening (SigLIP-2, opsiyonel) ──────────────────────────────────
# Kampanya 2026-08-08: her iki alanda tam recall'de en düşük VLM kapsaması.
# Önce görüntü kulesini bir kez aktarın (torch'lu ayrı bir venv'de):
#   python scripts/export_siglip.py     → models/semantic/local/ (git-ignored)
# sonra üçünü birlikte açın (v1.1 4-çapa seti, çalışma noktası ölçümle
# st=0.80/ct=0.48 → val 13/13 @ %39,9 · feed 19/19 @ %40,0):
# DORTGOZ_CANDIDATE_MODEL_MANIFEST=models/semantic/manifest.json
# DORTGOZ_CANDIDATE_START_THRESHOLD=0.80
# DORTGOZ_CANDIDATE_CONTINUE_THRESHOLD=0.48
# Per-kamera eşik adaptasyonu: v1.0 6-çapa setiyle ölçülmüş kazançtı; v1.1
# çapa setinde recall DÜŞÜRÜYOR (ölçümle) — v1.1 ile KAPALI tutun.
# DORTGOZ_CANDIDATE_ADAPTIVE_THRESHOLD=1

# Opsiyonel yerel kalıcılık: SQLite dosyası repo köküne göre çözülür. Docker Compose
# bunu otomatik olarak runs/event_memory.sqlite3 yoluna ayarlar.
# Transactional olay/inceleme/model yaşam döngüsü kontrol düzlemi.
DORTGOZ_EVENT_STORE_PATH=runs/event_memory.sqlite3
# Gerçek teslim provasında ayrıca şunu kullanın:
# DORTGOZ_DEPLOYMENT_PROFILE=competition-real

# ── Yerel UCF-Crime kopyası (isteğe bağlı) ────────────────────────────────────
# Yalnız scripts/make_long_feed.py kullanır. Veri seti kendi diskinizde kalır;
# kopyalanmaz ve repoya girmez. UCF_Crimes veya UCF_Crimes/Videos kabul edilir.
# Ayarlanmamışsa betik çalışmaz; yanlış makinedeki bir varsayılan yolu asla denemez.
# Komut satırından da verilebilir: --ucf /yol
# DORTGOZ_UCF_DIR=/disk/yolu/UCF_Crimes

# Çalışma kipi bayrakları (dengeli kipin dışına yalnız ölçülü ihtiyaçla çıkın;
# per-koşu seçim için arayüzdeki kip seçicisini veya start_run.mode kullanın)
# DORTGOZ_DUAL_READ=1     # geniş kipin çift okuması (kalıcı/global)
# DORTGOZ_FINAL_SWEEP=1   # olaysız koşuya 16-karelik son tarama (kalıcı/global)

# İkinci görüş (çapraz model) — VARSAYILAN AÇIK, hibrit mimari kararı
# (2026-08-19): 35B olaysız + hareketli pencereyi 27B bir kez daha okur.
# Yakalama 95 → 110/140, yanlış alarm 14 → 16/150, maliyet 1,4×.
# Tek kollu 35B'ye dönmek için BOŞ bırakın:
# DORTGOZ_SECOND_OPINION_MODEL=
