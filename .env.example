# Dörtgöz backend ortamı — bu ŞABLON commit edilir, doldurulmuş .env EDİLMEZ.
# Kopyala: cp .env.example .env  → değerleri doldur. Backend kökteki .env'i otomatik okur.

# ── Ana model sunucusu (Arda'nın masaüstü, OpenAI-uyumlu) ────────────────────
# Uzaktan erişim ekip içinde ayrıca paylaşılır;
# sonra endpoint'i Arda'nın verdiği özel ağ adresiyle doldur. API anahtarı gerekmez ("local" yaz).
# Yalnızca /v1/* uçları açıktır; bir modelin ilk isteği 5-90 sn soğuk yükleme alabilir.
DORTGOZ_LLAMA_BASE_URL=http://<uzak-sunucu-adresi>:8080/v1
DORTGOZ_API_KEY=local
DORTGOZ_MAIN_MODEL=qwen3.6-35b-a3b-vision

# ── vLLM ön eleme (RTX 4060 dizüstü; kendi makinesinde koşan doldurur) ───────
DORTGOZ_VLLM_BASE_URL=http://127.0.0.1:8001/v1
DORTGOZ_TRIAGE_MODEL=minicpm-v-4.6

# ── Mod ──────────────────────────────────────────────────────────────────────
# GPU'suz arayüz geliştirme için mock olay akışı:
# DORTGOZ_MOCK=1
