{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dortgoz-candidate-annotation-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["video_id", "source_ref", "split", "intervals"],
  "properties": {
    "video_id": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "split": {"type": "string", "enum": ["train", "validation", "test"]},
    "intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_time", "end_time", "label"],
        "properties": {
          "start_time": {"type": "number", "minimum": 0},
          "end_time": {"type": "number", "exclusiveMinimum": 0},
          "label": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
